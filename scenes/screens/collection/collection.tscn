[node name="CollectionScreen" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
layout_mode = 3
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("Script_collection")
style_card_discovered = SubResource("StyleBoxFlat_card_discovered")
style_card_locked = SubResource("StyleBoxFlat_card_locked")
style_img_bg = SubResource("StyleBoxFlat_card_img_bg")
style_img_locked_bg = SubResource("StyleBoxFlat_card_img_locked_bg")
style_tag_bg = SubResource("StyleBoxFlat_tag_bg")

; ---- Background ----
[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.973, 0.976, 0.980, 1)

; ============================================================
; TOP APP BAR
; ============================================================
[node name="TopAppBar" parent="." instance=ExtResource("TopAppBar")]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2

; ============================================================
; MAIN LAYOUT (VBoxContainer fills screen minus top/bottom bars)
; ============================================================
[node name="MainLayout" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 72
offset_bottom = -148
layout_mode = 1
grow_horizontal = 2
grow_vertical = 2

; ============================================================
; SCROLL AREA
; ============================================================
[node name="ScrollContainer" type="ScrollContainer" parent="MainLayout"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContentVBox" type="VBoxContainer" parent="MainLayout/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

; ---- Margin padding ----
[node name="TopPadding" type="Control" parent="MainLayout/ScrollContainer/ContentVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)

[node name="SidePadding" type="MarginContainer" parent="MainLayout/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24

[node name="InnerContent" type="VBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding"]
layout_mode = 2
theme_override_constants/separation = 24

; ============================================================
; TITLE SECTION
; ============================================================
[node name="TitleSection" type="VBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ScreenTitle" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection"]
layout_mode = 2
text = "COLLECTION"
theme_override_font_sizes/font_size = 36
theme_override_colors/font_color = Color(0.420, 0.220, 0.831, 1)
uppercase = true

; ---- Completion Panel ----
[node name="CompletionPanel" type="PanelContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_completion_panel")

[node name="CompletionVBox" type="VBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CompletionRow" type="HBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox"]
layout_mode = 2

[node name="CompletionLabel" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox/CompletionRow"]
layout_mode = 2
text = "COMPLETION"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.286, 0.267, 0.329, 1)

[node name="CompletionSpacer" type="Control" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox/CompletionRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CompletionPct" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox/CompletionRow"]
layout_mode = 2
text = "35%"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.420, 0.220, 0.831, 1)

; Progress Bar
[node name="ProgressBarBg" type="PanelContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
theme_override_styles/panel = SubResource("StyleBoxFlat_progress_bg")

[node name="ProgressFill" type="PanelContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox/ProgressBarBg"]
layout_mode = 2
anchor_right = 0.35
anchor_bottom = 1.0
theme_override_styles/panel = SubResource("StyleBoxFlat_progress_fill")

[node name="CompletionHint" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection/CompletionPanel/CompletionVBox"]
layout_mode = 2
text = "Find 12 more monsters to unlock the 'Mystic Forest' biome!"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.286, 0.267, 0.329, 1)
autowrap_mode = 3

; ============================================================
; CARD GRID (2 columns via GridContainer)
; ============================================================
[node name="CardGrid" type="GridContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12

; ============================================================
; TAP HINT
; ============================================================
[node name="TapHint" type="VBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 4
modulate = Color(1, 1, 1, 0.6)

[node name="TapIcon" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TapHint"]
layout_mode = 2
text = "👆"
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="TapLabel" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TapHint"]
layout_mode = 2
text = "TAP FOR DETAILS"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.286, 0.267, 0.329, 1)
horizontal_alignment = 1

[node name="BottomPadding" type="Control" parent="MainLayout/ScrollContainer/ContentVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 16)

; ============================================================
; BOTTOM NAVIGATION
; ============================================================
[node name="BottomNav" parent="." instance=ExtResource("BottomNav")]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -148
grow_horizontal = 2
grow_vertical = 0
