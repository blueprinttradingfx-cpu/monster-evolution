; ============================================================
; ROOT
; ============================================================
[node name="CollectionScreen" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
layout_mode = 3
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("Script_collection")

; ---- Background ----
[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.973, 0.976, 0.980, 1)

; ============================================================
; TOP APP BAR
; ============================================================
[node name="TopAppBar" parent="." instance=ExtResource("TopAppBar")]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2

; ============================================================
; MAIN LAYOUT (VBoxContainer fills screen minus top/bottom bars)
; ============================================================
[node name="MainLayout" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 72
offset_bottom = -148
layout_mode = 1
grow_horizontal = 2
grow_vertical = 2

; ============================================================
; SCROLL AREA
; ============================================================
[node name="ScrollContainer" type="ScrollContainer" parent="MainLayout"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContentVBox" type="VBoxContainer" parent="MainLayout/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

; ---- Margin padding ----
[node name="TopPadding" type="Control" parent="MainLayout/ScrollContainer/ContentVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)

[node name="SidePadding" type="MarginContainer" parent="MainLayout/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24

[node name="InnerContent" type="VBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding"]
layout_mode = 2
theme_override_constants/separation = 24

; ============================================================
; TITLE SECTION
; ============================================================
[node name="TitleSection" type="VBoxContainer" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ScreenTitle" type="Label" parent="MainLayout/ScrollContainer/ContentVBox/SidePadding/InnerContent/TitleSection"]
layout_mode = 2
text = "COLLECTION"
